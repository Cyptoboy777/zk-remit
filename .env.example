# Copy to .env (untracked, gitignored) on the machine that deploys. Never commit a real value.
# The wallet that holds tNIGHT + tDUST on Midnight Preview. Use ONE of these (the phrase is easiest):
# your Lace 24-word recovery phrase, in quotes, or a 64-hex-character seed.
MIDNIGHT_WALLET_MNEMONIC=
# MIDNIGHT_WALLET_SEED=
# Optional overrides (defaults are the public Preview endpoints and a local proof server):
# PROOF_SERVER_URL=http://localhost:6300
# PREVIEW_INDEXER_URL=
# PREVIEW_INDEXER_WS_URL=
# PREVIEW_NODE_URL=
