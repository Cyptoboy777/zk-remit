{
  "name": "@zk-remit/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run copy-zk",
    "copy-zk": "mkdir -p dist/keys dist/zkir dist/compiler && cp -r ../contract/src/managed/zk-remit/keys/. dist/keys/ && cp -r ../contract/src/managed/zk-remit/zkir/. dist/zkir/ && cp -r ../contract/src/managed/zk-remit/compiler/. dist/compiler/",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnightntwrk/dapp-connector-api": "4.1.0",
    "@types/three": "^0.187.0",
    "@zk-remit/contract": "0.1.0",
    "buffer": "^6.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.8.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0"
  }
}
